# ---------------------------------------------------------------------------
# Kitchen Inventory Kiosk – copy to .env and adjust.
# ---------------------------------------------------------------------------

# --- Grocy ------------------------------------------------------------------
# Base URL of your Grocy instance (without /api). Inside docker-compose use the
# service name, e.g. http://grocy:80; otherwise e.g. http://192.168.1.10:9283
GROCY_URL=http://grocy:80
# Grocy -> Settings (top right) -> Manage API keys. Sent as the GROCY-API-KEY header.
GROCY_API_KEY=change-me
# Location ID used when adding stock (Grocy -> Master data -> Locations, see the
# id in the edit URL). Leave empty to use each product's default location.
GROCY_DEFAULT_LOCATION_ID=1
# Fallback best-before offset (days) when a product has no "Default due days".
GROCY_DEFAULT_BEST_BEFORE_DAYS=7
# Optional: quantity unit ID for products created from the kiosk.
# Leave empty to use the first quantity unit defined in Grocy.
GROCY_DEFAULT_QUANTITY_UNIT_ID=

# --- Categories -------------------------------------------------------------
# Grocy Product Groups are split on this delimiter into Major -> Subcategory
# buttons, e.g. "Dairy/Butter", "Canned/Tomatoes", "Long Life/Sauces".
CATEGORY_DELIMITER=/
# Create the suggested default category tree (Bakery, Cooking, Long-Life, …) in
# Grocy at startup. Existing groups are never touched; set false to disable.
SEED_DEFAULT_CATEGORIES=true

# --- Brother QL printer -----------------------------------------------------
PRINTER_MODEL=QL-800
# linux_kernel (uses /dev/usb/lp0, recommended) or pyusb (talks libusb directly)
PRINTER_BACKEND=linux_kernel
# linux_kernel: file:///dev/usb/lp0
# pyusb:        usb://0x04f9:0x209b
PRINTER_IDENTIFIER=file:///dev/usb/lp0
# Continuous roll width in mm (62 = DK-22205 62mm continuous)
PRINTER_LABEL_SIZE=62
PRINTER_AUTO_CUT=true
# Set to true for two-colour Black/Red rolls (DK-22251); keep false for
# monochrome rolls such as DK-22205.
PRINTER_RED=false

# --- Labels -----------------------------------------------------------------
# Labels encode <prefix><stock_id> as Code 128; "grcy:s:" is understood by Grocy too.
BARCODE_PREFIX=grcy:s:

# --- Kiosk ------------------------------------------------------------------
# Seconds the UNDO button is offered before a scanned item is removed from Grocy.
CONSUME_COUNTDOWN_SECONDS=5
# Return to the CONSUME screen after this many seconds without interaction (0 = off).
UI_IDLE_RETURN_SECONDS=300
# Port the kiosk web app listens on.
APP_PORT=8080
